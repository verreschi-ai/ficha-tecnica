rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 🔒 USUARIOS E SUB-COLEÇÕES: Acesso restrito estritamente ao próprio dono autenticado (request.auth.uid == userId)
    match /usuarios/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 🔒 INSUMOS: Acesso restrito ao usuário proprietário
    match /insumos/{insumoId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }

    // 🔒 RECEITAS: Acesso restrito ao usuário proprietário
    match /receitas/{receitaId} {
      allow read, write: if isSignedIn() && (
        (resource != null && resource.data.userId == request.auth.uid) ||
        (request.resource != null && request.resource.data.userId == request.auth.uid)
      );
    }
  }
}
