# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADOPAGO_ACCESS_TOKEN: Mercado Pago Access Token for Subscriptions API (Reset for Production Go-Live)
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_PUBLIC_KEY: Mercado Pago Public Key for frontend checkout integration (Reset for Production Go-Live)
MERCADOPAGO_PUBLIC_KEY=""

# --- Exportação de dados para o painel de marketing (GRE Marketing / Don Giovanni) ---
# Endpoint GET /api/export/summary: resumo somente-leitura de fichas técnicas (CMV, margem,
# preço) e insumos de UM único usuário, pra Ana (a IA do painel de marketing) usar. Os 3
# valores abaixo precisam estar configurados juntos, senão o endpoint responde 503.

# EXPORT_API_TOKEN: token compartilhado que o painel de marketing envia no header
# "x-export-token". Gere um valor aleatório longo (ex.: openssl rand -hex 32) e cole o mesmo
# valor na tela de conexão do painel de marketing — nunca reaproveite outra credencial aqui.
EXPORT_API_TOKEN=""

# EXPORT_OWNER_USER_ID: o id (campo "id" do documento em "usuarios" no Firestore, o mesmo
# usado como "userId" nos documentos de "receitas"/"insumos") da conta cujos dados serão
# exportados — sempre a conta do Don Giovanni, nunca de outro cliente do Margem de Chefe.
EXPORT_OWNER_USER_ID=""

# FIREBASE_SERVICE_ACCOUNT_JSON: JSON completo (em uma linha) de uma chave de conta de
# serviço do Firebase (Firebase Console → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada), usada pelo Admin SDK pra ler o Firestore direto no servidor
# (contorna as firestore.rules, que só liberam leitura para o dono do próprio documento).
# Trate como um segredo tão sensível quanto uma senha de banco.
FIREBASE_SERVICE_ACCOUNT_JSON=""
