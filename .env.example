# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MERCADOPAGO_ACCESS_TOKEN: Mercado Pago Access Token for Subscriptions API (Reset for Production Go-Live)
MERCADOPAGO_ACCESS_TOKEN=""

# MERCADOPAGO_PUBLIC_KEY: Mercado Pago Public Key for frontend checkout integration (Reset for Production Go-Live)
MERCADOPAGO_PUBLIC_KEY=""

# --- Exportação de dados para o painel de marketing (GRE Marketing / Don Giovanni) ---
# O próprio app envia (POST /api/export/push) o snapshot atual de fichas técnicas e insumos
# sempre que o usuário salva algo, e GET /api/export/summary serve um resumo disso pro painel
# de marketing consumir. As 2 variáveis abaixo precisam estar configuradas juntas.

# EXPORT_API_TOKEN: token compartilhado que o painel de marketing envia no header
# "x-export-token" ao consultar GET /api/export/summary. Gere um valor aleatório longo
# (ex.: openssl rand -hex 32) e cole o mesmo valor na tela de conexão do painel de marketing.
EXPORT_API_TOKEN=""

# EXPORT_OWNER_EMAIL: o e-mail de login (na Ficha Técnica) da conta cujos dados serão
# exportados — sempre a conta do Don Giovanni. Dados enviados por qualquer outro e-mail via
# POST /api/export/push são silenciosamente ignorados, pra nunca misturar com outro cliente
# do Margem de Chefe.
EXPORT_OWNER_EMAIL=""
